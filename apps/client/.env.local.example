# apps/client local dev environment
# Copy to .env.local (gitignored) and fill real values.
# Production values are injected by deploy/scripts/after_deploy.sh from SSM
# (/nomacom/client/DATABASE_URL + /nomacom/shared/maya/*).

DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

MAYA_API_ENDPOINT=https://api.maya.net/connectivity/v1
MAYA_API_CLIENT_ID=
MAYA_API_CLIENT_SECRET=

# 판매 사이트 shell (W1-2) — runtimeConfig 런타임 덮어쓰기(NUXT_PUBLIC_*)
# 주문번호 조회가 보내는 발급 호스트 — 로컬 dev 는 자기 자신으로
# (QA walk 는 .env.local 없이 .claude/scripts/client-walk-server.sh 로 — 봉투가 이 파일이 있으면 기동을 거부한다)
NUXT_PUBLIC_GUEST_APP_ORIGIN=http://localhost:3000
# /checkout-preview 전용 PortOne V2 공개값 — 테스트 채널키만. 비워 두면 결제 버튼이 비활성
NUXT_PUBLIC_PORTONE_STORE_ID=
NUXT_PUBLIC_PORTONE_TEST_CHANNEL_KEY=
